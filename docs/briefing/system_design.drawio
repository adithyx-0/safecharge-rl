<mxfile host="app.diagrams.net"><diagram id="sys" name="SafeCharge-RL system design"><mxGraphModel dx="1100" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="540" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="data" value='&lt;b style="font-size:15px"&gt;1  ACN-Data&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Real Caltech / JPL charging sessions: arrival, true departure, energy needed&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9FA;strokeColor=#4A7FC1;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#1B1F2A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="230" height="170" as="geometry"/></mxCell><mxCell id="report" value='&lt;b style="font-size:15px"&gt;2  Report model&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Makes the departure the policy sees: truthful, noisy, late, or faked early&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFD9;strokeColor=#5E9E4E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#1B1F2A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="230" height="170" as="geometry"/></mxCell><mxCell id="env" value='&lt;b style="font-size:15px"&gt;3  Environment&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Ports, price, grid cap. Cars leave at their TRUE time; unmet energy is counted then&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#C9A227;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#1B1F2A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="50" width="230" height="170" as="geometry"/></mxCell><mxCell id="eval" value='&lt;b style="font-size:15px"&gt;6  Evaluation&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Cost, unmet energy, grid violations, cheating gain vs baselines and optimum&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#777777;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#1B1F2A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="50" width="200" height="170" as="geometry"/></mxCell><mxCell id="proj" value='&lt;b style="font-size:15px"&gt;5  Safety projection&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Cuts the requested power to the grid cap: a hard guarantee&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7DDF0;strokeColor=#8B63A8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#1B1F2A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="265" height="170" as="geometry"/></mxCell><mxCell id="agent" value='&lt;b style="font-size:15px"&gt;4  RL agent&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;PPO-Lagrangian, Deep Sets network. Multipliers rise when a cost budget is broken&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8D5D3;strokeColor=#C0504D;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontColor=#1B1F2A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="270" height="170" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="data" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="report" target="env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="env" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="state s, reward R, costs c1, c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="env" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="action u (0 to 1 per port)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent" target="proj"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="safe power p (total within cap)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B2545;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontColor=#0B2545;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proj" target="env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="reported departure only" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="230" height="24" as="geometry"/></mxCell><mxCell id="n2" value="Loop repeats every 15 minutes, 96 steps per day. The true departure is never shown to the agent." style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1040" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>